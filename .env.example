# Generate independent hexadecimal secrets: python3 -c 'import secrets; print(secrets.token_hex(32))'
# Hexadecimal avoids URL-escaping problems in DATABASE_URL.
SECRET_KEY=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=

# Development: http://localhost:8080
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080
CADDY_SITE=:80

# Production: set DOMAIN, ALLOWED_HOSTS=your.domain and CSRF_TRUSTED_ORIGINS=https://your.domain
DOMAIN=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=portal@example.com

# Optional: enable only when all subdomains use HTTPS and preload is intentional.
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false

# Optional: apps.integrations.management.commands.sync_netbackup. Leave both
# unset and the command no-ops. Token must match NetBackup's own
# PORTAL_SYNC_TOKEN (see that project's .env.example).
# Local dev, NetBackup on the same host: http://host.docker.internal:8001
# (NetBackup's API_PORT). Production: https://<NetBackup DOMAIN>.
NETBACKUP_API_URL=
NETBACKUP_API_TOKEN=

# Optional: apps.ai_assist (Assistente IA, tela consultor-only). Leave both
# unset and the assistant shows "não configurado" without calling out.
# Get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
